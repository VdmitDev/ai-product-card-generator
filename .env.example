# Скопируйте файл в .env и впишите свой ключ. Файл .env в git не попадает.

# Ключ OpenAI API: https://platform.openai.com/api-keys
OPENAI_API_KEY=ваш_ключ

# Модель. gpt-6-luna: самая дешёвая актуальная модель OpenAI для массовых задач.
OPENAI_MODEL=gpt-6-luna

# Глубина рассуждений для reasoning-моделей: none, low, medium, high.
# Пустое значение: параметр не передаётся. Если модель его не поддерживает, сервис уберёт его сам.
OPENAI_REASONING_EFFORT=low

# Сколько раз просить модель исправить ответ, если он не прошёл автоматические проверки.
MAX_REPAIR_ATTEMPTS=2

# Таймаут одного запроса к API, секунд.
OPENAI_TIMEOUT=60

# Необязательные настройки, раскомментируйте при необходимости:
# Температура. Reasoning-модели её обычно не принимают, поэтому по умолчанию не передаётся.
# OPENAI_TEMPERATURE=0.3
# Адрес OpenAI-совместимого API (Ollama, vLLM, LM Studio, корпоративный прокси).
# OPENAI_BASE_URL=http://localhost:11434/v1
# Уровень логов сервиса: DEBUG, INFO, WARNING.
# LOG_LEVEL=INFO
